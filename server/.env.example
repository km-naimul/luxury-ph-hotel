# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Option 1: Full connection string (recommended)
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/sk-hotel
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sk-hotel?retryWrites=true&w=majority

# Option 2: Separate credentials (optional - if not included in MONGODB_URI)
# MONGODB_USER=your-username
# MONGODB_PASSWORD=your-password

# JWT Secret (for authentication - CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production-use-random-string-here
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
